generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
    url      = env("DATABASE_URL")
}

model ProductionRecord {
  id          Int      @id @default(autoincrement())
  date        String
  shift       String
  line        String
  product     String
  plannedQty  Int
  actualQty   Int
  createdAt   DateTime @default(now())
}

model DowntimeRecord {
  id         Int      @id @default(autoincrement())
  date       String
  shift      String
  line       String
  cause      String
  minutes    Int
  createdAt  DateTime @default(now())
}